# Local Docker environment. Never commit a populated .env.
APP_NAME=PitchPond
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

POSTGRES_DB=pitchpond
POSTGRES_USER=pitchpond
POSTGRES_PASSWORD=pitchpond-local-only
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pitchpond
DB_USERNAME=pitchpond
DB_PASSWORD=pitchpond-local-only

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CLIENT=predis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_COOKIE=pitchpond_session
QUEUE_CONNECTION=redis
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000,127.0.0.1:3000,127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=hello@pitchpond.local
MAIL_FROM_NAME=PitchPond

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=pitchpond
AWS_SECRET_ACCESS_KEY=pitchpond-local-storage
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=pitchpond-private
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

PITCHPOND_INVITE_CODE=pond-beta-2026
PAYMENT_DRIVER=simulated
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_LEVEL_NAME=pitchpond-founder-idv

SENTRY_LARAVEL_DSN=
NEXT_PUBLIC_SENTRY_DSN=
